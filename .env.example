# Copiez ce fichier en .env.local si vous voulez surcharger ces valeurs.
# Le projet et la base de données du Groupe TKR sont déjà renseignés par
# défaut directement dans le code (src/lib/appwrite.js) — ce fichier ne sert
# qu'à les personnaliser (endpoint self-hosted, noms de collections
# différents, etc.) ou à fournir la clé API du script d'installation.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a5b3134001064862b43
VITE_APPWRITE_DATABASE_ID=6a5b328400308612967e

# Identifiants des collections (laisser tel quel si vous utilisez les noms
# proposés par setup/seed-appwrite.mjs)
VITE_COL_BRANCHES=branches
VITE_COL_VALUES=values
VITE_COL_SERVICES=services
VITE_COL_PROJECTS=projects
VITE_COL_TEAM=team
VITE_COL_TESTIMONIALS=testimonials
VITE_COL_JOBS=jobs
VITE_COL_EVENTS=events
VITE_COL_BLOG=blog
VITE_COL_RENTALS=rentals
VITE_COL_LANDS=lands
VITE_COL_COMMERCE=commerce
VITE_COL_NEWSLETTER=newsletter
VITE_COL_MESSAGES=messages
VITE_COL_APPLICATIONS=applications
VITE_COL_SETTINGS=site_settings

# Bucket de stockage pour les CV et lettres de motivation (page Carrières) —
# seul usage d'Appwrite Storage sur ce projet, les images passent par
# Cloudinary (voir APPWRITE_SCHEMA.md)
VITE_BUCKET_APPLICATIONS=media

# Cloudinary (à activer plus tard — voir APPWRITE_SCHEMA.md)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Utilisé uniquement par setup/seed-appwrite.mjs (jamais lu par le site
# lui-même, ne pas préfixer par VITE_, ne jamais commiter ce fichier)
APPWRITE_API_KEY=
