# Copiez ce fichier en .env.local et complétez les valeurs une fois le
# projet Appwrite du Groupe TKR créé. Tant que ce fichier n'existe pas
# (ou que VITE_APPWRITE_PROJECT_ID est vide), le site fonctionne avec le
# contenu provisoire de src/data/seed/*.json — rien n'est cassé en attendant.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=tkr_main

# Identifiants des collections (laisser tel quel si vous utilisez les noms
# proposés par setup/seed-appwrite.mjs)
VITE_COL_BRANCHES=branches
VITE_COL_VALUES=values
VITE_COL_SERVICES=services
VITE_COL_PROJECTS=projects
VITE_COL_TEAM=team
VITE_COL_TESTIMONIALS=testimonials
VITE_COL_JOBS=jobs
VITE_COL_EVENTS=events
VITE_COL_BLOG=blog

# Utilisé uniquement par setup/seed-appwrite.mjs (jamais lu par le site
# lui-même, ne pas préfixer par VITE_, ne jamais commiter ce fichier)
APPWRITE_API_KEY=
